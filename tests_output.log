        await cstore.add_column(ds["id"], "region", "Region", "select", {
            "options": [
                {"key": "eu", "label": {"en": "Europe", "pl": "Europa"}, "color": "#3b82f6"},
                {"key": "us", "label": {"en": "USA", "pl": "USA"}, "color": "#f59e0b"},
